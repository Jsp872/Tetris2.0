/* =====================================================================
   Menu principal - titre et boutons à gauche, carrousel de musiques à droite.
   Les styles partagés (verre, légendes) sont dans Common.uss.
   ===================================================================== */

.menu-root {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 0 140px 0 150px;
    color: rgb(240, 244, 255);
    -unity-font: url("../Art/Fonts/Poppins-SemiBold.ttf");
    -unity-font-definition: initial;
}

/* ---------- Fond qui suit la musique ---------- */
/* Fondu enchaîné doux : le nouveau calque apparaît en se posant (léger dézoom), l'ancien s'efface. */

.menu-background {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.menu-background__layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0.6;
    scale: 1 1;
    transition-property: opacity, scale;
    transition-duration: 1.1s, 1.6s;
    transition-timing-function: ease-in-out, ease-out-cubic;
}

.menu-background__layer--hidden {
    opacity: 0;
    scale: 1.08 1.08;
}

.menu-background__image {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.menu-column {
    width: 560px;
    align-items: stretch;
}

/* ---------- Titre ---------- */

.menu-title {
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
    margin-bottom: 34px;
}

.menu-title__main {
    font-size: 128px;
    letter-spacing: 10px;
    color: rgb(255, 255, 255);
    -unity-font: url("../Art/Fonts/Poppins-Bold.ttf");
    -unity-font-definition: initial;
    text-shadow: 0 8px 24px rgba(40, 20, 120, 0.6);
    margin: 0;
    padding: 0;
}

.menu-title__accent {
    font-size: 54px;
    color: rgb(125, 230, 255);
    -unity-font: url("../Art/Fonts/Poppins-Bold.ttf");
    -unity-font-definition: initial;
    text-shadow: 0 0 18px rgba(80, 210, 255, 0.9);
    margin: 0 0 26px 10px;
    padding: 0;
}

/* ---------- Panneaux ---------- */

.menu-panels {
    min-height: 420px;
}

.menu-panel {
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.25s, 0.35s;
    transition-timing-function: ease-out, ease-out-back;
}

.menu-panel--hidden {
    opacity: 0;
    translate: 60px 0;
}

.menu-panel__caption {
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

/* ---------- Boutons ---------- */

Button.menu-button {
    height: 88px;
    margin: 18px 0 0 0;
    padding: 0;
    border-radius: 44px;
    font-size: 30px;
    letter-spacing: 6px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-font: url("../Art/Fonts/Poppins-Bold.ttf");
    -unity-font-definition: initial;
    scale: 1 1;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.18s, 0.18s, 0.18s;
    transition-timing-function: ease-out-back, ease-out, ease-out;
}

Button.menu-button:hover,
Button.menu-button:focus {
    scale: 1.04 1.04;
    background-color: rgba(255, 255, 255, 0.16);
    border-color: rgba(140, 225, 255, 0.55);
    border-top-color: rgba(255, 255, 255, 0.75);
}

Button.menu-button:active {
    scale: 0.97 0.97;
    background-color: rgba(255, 255, 255, 0.22);
}

Button.menu-button--primary {
    height: 104px;
    font-size: 38px;
    border-radius: 52px;
    background-color: rgba(125, 200, 255, 0.2);
    border-color: rgba(140, 225, 255, 0.4);
    border-top-color: rgba(255, 255, 255, 0.7);
}

Button.menu-button--small {
    height: 64px;
    font-size: 22px;
    border-radius: 32px;
    margin-top: 22px;
}

/* ---------- Cartes de mode ---------- */

Button.mode-card {
    flex-direction: column;
    align-items: flex-start;
    margin: 16px 0 0 0;
    padding: 22px 30px 24px 30px;
    border-radius: 34px;
    -unity-text-align: upper-left;
    scale: 1 1;
    translate: 0 0;
    transition-property: scale, background-color, border-color, translate;
    transition-duration: 0.18s, 0.18s, 0.18s, 0.06s;
    transition-timing-function: ease-out-back, ease-out, ease-out, ease-in-out;
}

Button.mode-card:hover,
Button.mode-card:focus {
    scale: 1.03 1.03;
    background-color: rgba(255, 255, 255, 0.15);
    border-color: rgba(140, 225, 255, 0.55);
    border-top-color: rgba(255, 255, 255, 0.75);
}

Button.mode-card:active {
    scale: 0.98 0.98;
}

.mode-card--shake-left {
    translate: -10px 0;
}

.mode-card--shake-right {
    translate: 10px 0;
}

.mode-card__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
}

.mode-card__title {
    font-size: 32px;
    letter-spacing: 5px;
    color: rgb(255, 255, 255);
    -unity-font: url("../Art/Fonts/Poppins-Bold.ttf");
    -unity-font-definition: initial;
    margin: 0;
    padding: 0;
}

.mode-card__badge {
    font-size: 13px;
    letter-spacing: 3px;
    color: rgb(255, 225, 140);
    background-color: rgba(255, 200, 80, 0.14);
    border-width: 1px;
    border-color: rgba(255, 210, 120, 0.4);
    border-radius: 12px;
    padding: 3px 12px;
    margin: 0;
}

.mode-card__description {
    font-size: 17px;
    color: rgba(225, 232, 255, 0.75);
    -unity-font: url("../Art/Fonts/Poppins-Medium.ttf");
    -unity-font-definition: initial;
    white-space: normal;
    margin: 6px 0 0 0;
    padding: 0;
}

/* ---------- Message temporaire ---------- */

.menu-toast {
    align-self: center;
    margin-top: 26px;
    font-size: 20px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-top-color: rgba(255, 255, 255, 0.45);
    border-radius: 22px;
    padding: 10px 26px;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.2s, 0.3s;
    transition-timing-function: ease-out, ease-out-back;
}

.menu-toast--hidden {
    opacity: 0;
    translate: 0 12px;
}

/* ---------- Carrousel de musiques ---------- */

.carousel {
    width: 400px;
    align-items: center;
    translate: 0 0;
    transition-property: translate;
    transition-duration: 0.11s;
    transition-timing-function: ease-out;
}

.carousel--shift-up {
    translate: 0 -16px;
}

.carousel--shift-down {
    translate: 0 16px;
}

Button.carousel__arrow {
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border-radius: 22px;
    justify-content: center;
    align-items: center;
    scale: 1 1;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.18s, 0.18s, 0.18s;
    transition-timing-function: ease-out-back, ease-out, ease-out;
}

Button.carousel__arrow:hover,
Button.carousel__arrow:focus {
    scale: 1.12 1.12;
    background-color: rgba(255, 255, 255, 0.18);
    border-color: rgba(140, 225, 255, 0.55);
}

Button.carousel__arrow:active {
    scale: 0.94 0.94;
}

.carousel__chevron {
    width: 12px;
    height: 12px;
    border-left-width: 3px;
    border-top-width: 3px;
    border-color: rgb(255, 255, 255);
    border-top-left-radius: 3px;
}

.carousel__chevron--up {
    rotate: 45deg;
    translate: 0 3px;
}

.carousel__chevron--down {
    rotate: 225deg;
    translate: 0 -3px;
}

.carousel__cover {
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgba(0, 0, 0, 0.3);
}

.carousel__cover--side {
    width: 192px;
    height: 108px;
    margin: 10px 0;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    opacity: 0.5;
    scale: 1 1;
    transition-property: opacity, scale;
    transition-duration: 0.18s, 0.18s;
}

.carousel__cover--side:hover {
    opacity: 0.85;
    scale: 1.04 1.04;
}

.carousel__current {
    padding: 8px;
    margin: 2px 0;
    border-radius: 24px;
}

.carousel__cover--current {
    width: 352px;
    height: 198px;
    border-radius: 17px;
}

.carousel__info {
    flex-direction: row;
    align-items: center;
    width: 352px;
    padding: 10px 6px 2px 6px;
}

.carousel__texts {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 12px;
}

.carousel__title {
    font-size: 19px;
    color: rgb(255, 255, 255);
    -unity-font: url("../Art/Fonts/Poppins-Bold.ttf");
    -unity-font-definition: initial;
    -unity-text-overflow-position: end;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
    margin: 0;
    padding: 0;
}

.carousel__artist {
    font-size: 13px;
    color: rgba(225, 232, 255, 0.65);
    -unity-font: url("../Art/Fonts/Poppins-Medium.ttf");
    -unity-font-definition: initial;
    margin: 0;
    padding: 0;
}

.equalizer {
    flex-direction: row;
    align-items: flex-end;
    width: 24px;
    height: 22px;
}

.equalizer__bar {
    width: 4px;
    height: 50%;
    margin-right: 2px;
    border-radius: 2px;
    background-color: rgb(125, 230, 255);
}
